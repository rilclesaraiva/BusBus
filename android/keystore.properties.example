# Modelo do "keystore.properties" que o build de release do Android lê
# (ver android/app/build.gradle). NUNCA preencher valores de verdade neste
# arquivo de exemplo — ele é commitado só como referência.
#
# Pra gerar um release build assinado NA SUA PRÓPRIA máquina (fora da
# Action do GitHub): copie este arquivo pra "android/keystore.properties"
# (sem o ".example"), coloque a chave de verdade (.p12/.jks) em algum lugar
# fora do Git e preencha os valores reais abaixo.
#
# storeFile é relativo à pasta "android/" (raiz deste projeto Gradle).
storeFile=../caminho/pra/sua/chave.p12
storePassword=sua-senha-aqui
keyAlias=release_key
keyPassword=sua-senha-aqui
